{
  "name": "@pointylab/dsh",
  "version": "0.4.13",
  "description": "Pointy for DeepSeek Harness: shake the mouse, point at anything on screen and ask DSH about it",
  "icon": "./icon.png",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "pointy"],
  "homepage": "https://github.com/pointylab/pointy#readme",
  "repository": { "type": "git", "url": "git+https://github.com/pointylab/pointy.git", "directory": "plugin" },
  "bugs": "https://github.com/pointylab/pointy/issues",
  "type": "module",
  "main": "build/src/node.js",
  "exports": {
    ".": "./build/src/node.js",
    "./client": "./build/lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "build",
    "pet",
    "cordis.patch.yml",
    "ASSETS.md",
    "icon.png",
    "locale"
  ],
  "os": ["win32", "darwin"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
